/* Theme toggle */
.theme-toggle {
width: 38px;
height: 38px;
border: 1px solid var(--line);
background: #ffffff08;
color: var(--text);
display: grid;
place-items: center;
border-radius: 11px;
cursor: pointer;
font-size: 16px;
transition: all .2s ease;
}

.theme-toggle:hover {
border-color: #b8ef5560;
color: var(--lime);
transform: translateY(-1px);
}

