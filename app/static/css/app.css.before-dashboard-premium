/* =========================================================
   CROPYIELD AI — GLOBAL THEME SYSTEM
   Dark = existing premium green
   Light = clean agricultural white/sage
   ========================================================= */

/* ---------- DARK THEME ---------- */

:root {
    --bg: #06140e;
    --bg-secondary: #071b12;
    --panel: #0b2016;
    --panel-2: #10281c;
    --panel-3: #142f20;

    --line: rgba(255,255,255,.09);

    --text: #f2f7f3;
    --text-secondary: #c5d0c9;
    --muted: #8c9c93;
    --muted-2: #687970;

    --lime: #b8ef55;
    --lime2: #d2ff82;

    --danger: #ff746d;
    --amber: #f7c85b;

    --input-bg: #06140e;
    --sidebar-bg: rgba(7,24,16,.93);
    --topbar-bg: rgba(7,24,16,.72);

    --shadow: 0 24px 70px rgba(0,0,0,.28);

    --hero-overlay:
        linear-gradient(
            90deg,
            rgba(4,19,13,.93) 0%,
            rgba(6,21,14,.78) 48%,
            rgba(6,20,14,.45) 100%
        ),
        linear-gradient(
            0deg,
            rgba(6,20,14,.94) 0%,
            transparent 55%,
            rgba(6,20,14,.55) 100%
        );

    --hero-bg: #07160e;
}

/* ---------- LIGHT THEME ---------- */

html[data-theme="light"] {
    --bg: #f4f8f3;
    --bg-secondary: #edf4ed;

    --panel: #ffffff;
    --panel-2: #f7faf7;
    --panel-3: #eef6ef;

    --line: rgba(22,62,38,.11);

    --text: #163321;
    --text-secondary: #365342;
    --muted: #64776b;
    --muted-2: #829188;

    --lime: #4d8f2d;
    --lime2: #39751f;

    --danger: #d94d48;
    --amber: #c58919;

    --input-bg: #ffffff;

    --sidebar-bg: rgba(255,255,255,.94);
    --topbar-bg: rgba(255,255,255,.86);

    --shadow: 0 20px 60px rgba(31,66,42,.10);

    --hero-overlay:
        linear-gradient(
            90deg,
            rgba(245,250,245,.96) 0%,
            rgba(245,250,245,.84) 45%,
            rgba(245,250,245,.50) 100%
        ),
        linear-gradient(
            0deg,
            rgba(245,250,245,.90) 0%,
            transparent 55%,
            rgba(245,250,245,.40) 100%
        );

    --hero-bg: #eaf3ea;
}

/* ---------- GLOBAL ---------- */

html,
body {
    background: var(--bg);
    color: var(--text);
    transition:
        background-color .25s ease,
        color .25s ease;
}

body {
    background: var(--bg);
}

.app-shell {
    background:
        radial-gradient(
            circle at 70% -10%,
            rgba(80,145,72,.13),
            transparent 30%
        ),
        var(--bg);
    transition: background .25s ease;
}

/* ---------- SIDEBAR ---------- */

.sidebar {
    background: var(--sidebar-bg);
    border-right-color: var(--line);
    box-shadow: 8px 0 35px rgba(0,0,0,.03);
}

.navitem {
    color: var(--muted);
}

.navitem:hover,
.navitem.active {
    background: rgba(77,143,45,.09);
    color: var(--text);
}

.side-label {
    color: var(--muted-2);
}

.user-mini {
    background: rgba(77,143,45,.05);
    border-color: var(--line);
}

.user-mini strong {
    color: var(--text);
}

.user-mini small {
    color: var(--muted);
}

.logout {
    color: var(--muted);
}

/* ---------- TOPBAR ---------- */

.topbar {
    background: var(--topbar-bg);
    border-bottom-color: var(--line);
}

.crumb {
    color: var(--muted);
}

.live-pill {
    color: var(--muted);
    border-color: var(--line);
    background: rgba(77,143,45,.05);
}

.icon-btn {
    color: var(--muted);
    border-color: var(--line);
    background: transparent;
}

.icon-btn:hover {
    color: var(--text);
    background: rgba(77,143,45,.08);
}

/* ---------- TEXT ---------- */

.page-head p,
.result-sub,
.pane-copy,
.model-hero p {
    color: var(--muted);
}

/* ---------- PANELS ---------- */

.panel {
    background:
        linear-gradient(
            145deg,
            var(--panel),
            var(--panel-2)
        );
    border-color: var(--line);
    box-shadow: var(--shadow);
}

.kpi {
    background:
        linear-gradient(
            145deg,
            var(--panel-3),
            var(--panel)
        );
    border-color: var(--line);
}

.kpi.accent {
    background:
        linear-gradient(
            145deg,
            rgba(77,143,45,.15),
            var(--panel)
        );
}

/* ---------- INPUTS ---------- */

input,
select,
textarea {
    background: var(--input-bg);
    color: var(--text);
    border-color: var(--line);
}

input::placeholder,
textarea::placeholder {
    color: var(--muted-2);
}

input:focus,
select:focus,
textarea:focus {
    border-color: rgba(77,143,45,.55);
    box-shadow: 0 0 0 3px rgba(77,143,45,.10);
}

/* ---------- BUTTONS ---------- */

.lime-btn {
    background: var(--lime);
    color: #10200f;
}

.lime-btn:hover {
    background: var(--lime2);
}

.glass-btn {
    background: rgba(77,143,45,.06);
    color: var(--text);
    border-color: var(--line);
}

.glass-btn:hover {
    background: rgba(77,143,45,.11);
}

/* ---------- TABLES ---------- */

th {
    color: var(--muted-2);
    border-bottom-color: var(--line);
}

td {
    color: var(--text-secondary);
    border-bottom-color: var(--line);
}

/* ---------- SIGNALS ---------- */

.meter {
    background: rgba(77,143,45,.10);
}

.meter i {
    background: var(--lime);
}

/* ---------- ACTIVITY ---------- */

.activity {
    border-top-color: var(--line);
}

.activity small {
    color: var(--muted-2);
}

.crop-icon {
    background: rgba(77,143,45,.12);
    color: var(--lime);
}

/* ---------- MOBILE NAV ---------- */

.mobile-nav {
    background: var(--sidebar-bg);
    border-top-color: var(--line);
}

.mobile-nav a {
    color: var(--muted);
}

.mobile-nav a.active {
    color: var(--lime);
}

/* ---------- ADMIN ---------- */

.admin-command-nav {
    background: transparent;
}

.admin-tab {
    color: var(--muted);
}

.admin-tab:hover,
.admin-tab.active {
    background: rgba(77,143,45,.08);
    color: var(--text);
}

.admin-tab span {
    color: var(--muted-2);
}

/* ---------- PROFILE / AUTH ---------- */

.auth-card,
.profile-card {
    background: var(--panel);
    border-color: var(--line);
    box-shadow: var(--shadow);
}

.auth-card > p {
    color: var(--muted);
}

.auth-foot {
    color: var(--muted);
}

.demo-box,
.helper,
.info-note {
    background: rgba(77,143,45,.045);
    border-color: var(--line);
}

/* =========================================================
   THEME TOGGLE
   ========================================================= */

.theme-toggle {
    width: 38px;
    height: 38px;
    border-radius: 11px;

    border: 1px solid var(--line);

    background: rgba(77,143,45,.05);
    color: var(--text);

    display: grid;
    place-items: center;

    cursor: pointer;

    transition:
        background .2s ease,
        transform .2s ease,
        border-color .2s ease;
}

.theme-toggle:hover {
    background: rgba(77,143,45,.12);
    transform: translateY(-1px);
}

.theme-toggle span {
    font-size: 16px;
    line-height: 1;
}

/* ---------- LANDING PAGE ---------- */

.landing,
.auth-page {
    background: var(--hero-bg);
    color: var(--text);
}

.video-overlay {
    background: var(--hero-overlay);
}

html[data-theme="light"] .hero-video {
    filter: saturate(.88) brightness(1.08);
}

.landing-section {
    background: var(--bg);
}

.feature-grid article {
    background: var(--panel);
    border-color: var(--line);
    box-shadow: var(--shadow);
}

.feature-grid p {
    color: var(--muted);
}

.landing-links {
    color: var(--text);
}

/* Landing navigation theme button */
.landing-theme-toggle {
    margin-left: 5px;
}

/* ---------- AUTH PAGES ---------- */

html[data-theme="light"] .auth-page {
    background:
        radial-gradient(
            circle at 20% 20%,
            rgba(77,143,45,.12),
            transparent 30%
        ),
        var(--bg);
}

html[data-theme="dark"] .auth-page,
html:not([data-theme]) .auth-page {
    background:
        radial-gradient(
            circle at 20% 20%,
            rgba(77,143,45,.13),
            transparent 30%
        ),
        var(--bg);
}

/* ---------- THEME TRANSITION ---------- */

* {
    transition-property:
        background-color,
        border-color,
        color,
        box-shadow;
    transition-duration: .18s;
    transition-timing-function: ease;
}

canvas,
video,
img {
    transition: none !important;
}

