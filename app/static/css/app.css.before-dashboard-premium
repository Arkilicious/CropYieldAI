/* =========================================================
   STABLE DASHBOARD CHART SIZING
   ========================================================= */

.dashboard-grid .panel canvas {
    display: block;
    width: 100% !important;
    max-width: 100%;
}

/* Yield intelligence */
.dashboard-grid .panel.large {
    min-height: 0;
}

.dashboard-grid .panel.large canvas#yieldChart {
    height: 240px !important;
    max-height: 240px !important;
}

/* Crop mix */
.dashboard-grid .panel canvas#cropChart {
    height: 220px !important;
    max-height: 220px !important;
}

/* Analytics page charts */
.panel canvas#analyticsYield,
.panel canvas#analyticsCrop,
.panel canvas#environmentChart {
    height: 240px !important;
    max-height: 240px !important;
}

/* Prevent Chart.js from causing flex/grid expansion */
.dashboard-grid .panel {
    min-width: 0;
    overflow: hidden;
}

.dashboard-grid .panel canvas {
    box-sizing: border-box;
}

