}

.nav-item:hover {
    background: rgba(184,239,85,.08);
    color: var(--text);
}

.nav-icon {
    width: 20px;
    min-width: 20px;
    text-align: center;
    font-size: 15px;
}

.sidebar-bottom {
    padding-top: 14px;
    border-top: 1px solid var(--line);
}

.topbar-left {
    display: flex;
    align-items: center;
    min-width: 0;
}

.topbar-right {
    display: flex;
    align-items: center;
    gap: 12px;
}

.topbar-heading {
    display: flex;
    flex-direction: column;
    gap: 2px;
}

.topbar-eyebrow {
    color: var(--lime);
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 1.5px;
}

.topbar-heading h1 {
    margin: 0;
    font-size: 18px;
    line-height: 1.2;
    color: var(--text);
    font-weight: 700;
}

.mobile-menu-button {
    display: none;
}

@media (max-width: 720px) {
    .mobile-menu-button {
        display: grid;
        place-items: center;
        width: 40px;
        height: 40px;
        border: 1px solid var(--line);
        border-radius: 10px;
        background: var(--panel);
        color: var(--text);
        cursor: pointer;
    }

    .topbar {
        gap: 10px;
    }

    .topbar-left {
        flex: 1;
    }

    .topbar-heading h1 {
        font-size: 15px;
    }
}

/* =========================================================
   MODERN SVG NAVIGATION ICONS
   ========================================================= */

.nav-icon {
    width: 20px;
    height: 20px;
    min-width: 20px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
}

.nav-icon svg,
.mobile-menu-button svg,
.theme-toggle svg {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
}

.nav-item:hover .nav-icon {
    color: var(--lime);
}

.mobile-menu-button svg {
    width: 20px;
    height: 20px;
}

.theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
}

.theme-toggle svg {
    width: 18px;
    height: 18px;
}

/* =========================================================
   CROPYIELD AI — PREMIUM ANALYTICS SYSTEM
   ========================================================= */

.analytics-head {
    padding-bottom: 28px;
}

.analytics-head .page-intro {
    max-width: 850px;
}

.analytics-head h1 {
    max-width: 900px;
    line-height: 1.02;
}


/* ---------- ANALYTICS SCOPE ---------- */

.analytics-scope {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 9px 13px;
    border: 1px solid rgba(184, 239, 85, .16);
    border-radius: 999px;
    background: rgba(184, 239, 85, .055);
    color: var(--muted);
    font-size: 10px;
    letter-spacing: .2px;
    white-space: nowrap;
    box-shadow: 0 8px 25px rgba(0, 0, 0, .08);
}

.analytics-scope .status-dot {
    width: 6px;
    height: 6px;
    margin: 0;
}


/* ---------- ANALYTICS KPI GRID ---------- */

.analytics-kpis {
    padding: 0 4%;
    margin-bottom: 14px;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
}


/* ---------- PREMIUM KPI CARD ---------- */

.analytics-stat-card {
    position: relative;
    min-width: 0;
    overflow: hidden;

    display: flex;
    align-items: center;
    gap: 14px;

    padding: 18px;

    border: 1px solid var(--line);
    border-radius: 18px;

    background:
        radial-gradient(
            circle at 100% 0%,
            rgba(184, 239, 85, .08),
            transparent 45%
        ),
        linear-gradient(
            145deg,
            var(--panel-3, #142f20),
            var(--panel, #0b2016)
        );

    box-shadow:
        0 16px 45px rgba(0, 0, 0, .12),
        inset 0 1px 0 rgba(255,255,255,.025);

    transition:
        transform .22s ease,
        border-color .22s ease,
        box-shadow .22s ease;
}

.analytics-stat-card:hover {
    transform: translateY(-2px);
    border-color: rgba(184, 239, 85, .18);
    box-shadow:
        0 22px 55px rgba(0, 0, 0, .16),
        inset 0 1px 0 rgba(255,255,255,.035);
}


/* ---------- KPI ICON ---------- */

.analytics-stat-icon {
    flex: 0 0 42px;
    width: 42px;
    height: 42px;

    display: inline-flex;
    align-items: center;
    justify-content: center;

    border: 1px solid rgba(184, 239, 85, .14);
    border-radius: 13px;

    background: rgba(184, 239, 85, .075);
    color: var(--lime);

    box-shadow:
        inset 0 1px 0 rgba(255,255,255,.04),
        0 8px 22px rgba(0,0,0,.08);
}

.analytics-stat-icon svg {
    width: 19px;
    height: 19px;

    fill: none;
    stroke: currentColor;
    stroke-width: 1.65;
    stroke-linecap: round;
    stroke-linejoin: round;
}

.analytics-stat-icon.accent {
    color: #c9f77d;
}

.analytics-stat-icon.warning {
    color: var(--amber);
    border-color: rgba(247, 200, 91, .15);
    background: rgba(247, 200, 91, .065);
}


/* ---------- KPI TEXT ---------- */

.analytics-stat-content {
    min-width: 0;
}

.analytics-stat-content span {
    display: block;

    color: #819188;
    font-size: 8px;
    font-weight: 800;
    letter-spacing: 1.35px;
    text-transform: uppercase;

    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.analytics-stat-content strong {
    display: block;

    margin-top: 6px;

    color: var(--text);
    font: 700 26px/1 'Space Grotesk', sans-serif;
    letter-spacing: -1px;
}

.analytics-stat-content strong i {
    color: var(--muted);
    font: 500 10px 'DM Sans', sans-serif;
    letter-spacing: 0;
}

.analytics-stat-content small {
    display: block;

    margin-top: 5px;

    color: #65756c;
    font-size: 9px;
}

.risk-stat {
    background:
        radial-gradient(
            circle at 100% 0%,
            rgba(247, 200, 91, .07),
            transparent 45%
        ),
        linear-gradient(
            145deg,
            var(--panel-3, #142f20),
            var(--panel, #0b2016)
        );
}


/* ---------- ANALYTICS GRID ---------- */

.analytics-grid {
    padding: 0 4% 50px;

    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, .85fr);
    gap: 12px;

    min-width: 0;
}

.analytics-grid .analytics-yield-panel {
    grid-column: 1 / -1;
}

.analytics-grid .analytics-environment-panel {
    grid-column: 1 / -1;
}


/* ---------- PREMIUM ANALYTICS PANEL ---------- */

.analytics-panel {
    position: relative;
    min-width: 0;
    overflow: hidden;

    border-radius: 19px;

    background:
        radial-gradient(
            circle at 100% 0%,
            rgba(184, 239, 85, .045),
            transparent 32%
        ),
        linear-gradient(
            145deg,
            var(--panel),
            var(--panel-2)
        );

    box-shadow:
        0 18px 55px rgba(0, 0, 0, .12),
        inset 0 1px 0 rgba(255,255,255,.025);

    transition:
        border-color .22s ease,
        box-shadow .22s ease;
}

.analytics-panel:hover {
    border-color: rgba(184, 239, 85, .13);
    box-shadow:
        0 22px 65px rgba(0, 0, 0, .16),
        inset 0 1px 0 rgba(255,255,255,.03);
}


/* ---------- PANEL HEADER ---------- */

.analytics-panel-head {
    margin-bottom: 6px;
    align-items: center;
}

.panel-title-group {
    min-width: 0;

    display: flex;
    align-items: center;
    gap: 12px;
}

.panel-title-group > div:last-child {
    min-width: 0;
}

.panel-title-group h2 {
    margin: 0;

    font-size: 15px;
    line-height: 1.2;
}

.panel-title-group > div:last-child > span {
    display: block;

    margin-top: 5px;

    color: #6f7f76;
    font-size: 9px;

    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}


/* ---------- PREMIUM PANEL ICON ---------- */

.panel-icon {
    flex: 0 0 38px;

    width: 38px;
    height: 38px;

    display: inline-flex;
    align-items: center;
    justify-content: center;

    border: 1px solid rgba(184, 239, 85, .13);
    border-radius: 12px;

    background:
        linear-gradient(
            145deg,
            rgba(184,239,85,.10),
            rgba(184,239,85,.035)
        );

    color: var(--lime);

    box-shadow:
        inset 0 1px 0 rgba(255,255,255,.04),
        0 7px 20px rgba(0,0,0,.08);
}

.panel-icon svg {
    width: 18px;
    height: 18px;

    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
}

.panel-icon.subtle {
    width: 31px;
    height: 31px;
    flex-basis: 31px;

    border-radius: 9px;

    color: #7d8d84;
    background: rgba(255,255,255,.025);
    border-color: var(--line);
}

.panel-icon.subtle svg {
    width: 14px;
    height: 14px;
}


/* ---------- PANEL STATUS ---------- */

.panel-status {
    display: inline-flex !important;
    align-items: center;
    gap: 5px;

    padding: 6px 8px;

    border: 1px solid rgba(184,239,85,.12);
    border-radius: 999px;

    background: rgba(184,239,85,.045);

    color: #8da095 !important;
    font-size: 7px !important;
    font-weight: 800;
    letter-spacing: 1px;
}

.panel-status i {
    width: 5px;
    height: 5px;

    display: inline-block;

    border-radius: 50%;
    background: var(--lime);

    box-shadow: 0 0 9px var(--lime);
}

.signal-badge {
    padding: 6px 8px;

    border: 1px solid var(--line);
    border-radius: 999px;

    color: #74847b !important;
    font-size: 7px !important;
    font-weight: 800;
    letter-spacing: 1px;
}


/* ---------- CHART CONTAINER ---------- */

.analytics-chart {
    position: relative;

    width: 100%;
    height: 290px;

    margin-top: 8px;

    min-width: 0;
}

.analytics-chart canvas {
    display: block !important;

    width: 100% !important;
    height: 100% !important;

    max-width: 100%;
}


/* ---------- DOUGHNUT ---------- */

.analytics-crop-panel .analytics-chart {
    height: 290px;

    display: flex;
    align-items: center;
    justify-content: center;
}

.analytics-crop-panel .analytics-chart canvas {
    max-width: 310px !important;
}


/* ---------- EMPTY STATE ---------- */

.analytics-empty {
    margin: 0 4% 14px;

    display: flex;
    align-items: center;
    gap: 18px;

    padding: 25px;

    border: 1px dashed rgba(184,239,85,.18);

    background:
        radial-gradient(
            circle at 0% 50%,
            rgba(184,239,85,.06),
            transparent 45%
        ),
        var(--panel);

    box-shadow:
        0 16px 45px rgba(0,0,0,.08);
}

.analytics-empty-icon {
    flex: 0 0 52px;

    width: 52px;
    height: 52px;

    display: flex;
    align-items: center;
    justify-content: center;

    border: 1px solid rgba(184,239,85,.15);
    border-radius: 15px;

    background: rgba(184,239,85,.07);
    color: var(--lime);
}

.analytics-empty-icon svg {
    width: 23px;
    height: 23px;

    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
}

.analytics-empty-content {
    min-width: 0;
}

.analytics-empty-content h2 {
    margin: 5px 0 5px;
    font-size: 18px;
}

.analytics-empty-content p {
    margin: 0 0 14px;
    max-width: 700px;

    color: #75847b;
    font-size: 10px;
    line-height: 1.65;
}


/* =========================================================
   LIGHT THEME
   ========================================================= */

html[data-theme="light"] .analytics-stat-card {
    background:
        radial-gradient(
            circle at 100% 0%,
            rgba(95,159,39,.055),
            transparent 45%
        ),
        #ffffff;

    border-color: rgba(18,32,24,.085);

    box-shadow:
        0 14px 38px rgba(20,35,27,.055),
        inset 0 1px 0 rgba(255,255,255,.8);
}

html[data-theme="light"] .analytics-stat-card:hover {
    border-color: rgba(95,159,39,.20);

    box-shadow:
        0 18px 45px rgba(20,35,27,.08);
}

html[data-theme="light"] .analytics-stat-icon {
    background: rgba(95,159,39,.075);
    border-color: rgba(95,159,39,.13);
}

html[data-theme="light"] .analytics-stat-content span {
    color: #718078;
}

html[data-theme="light"] .analytics-stat-content strong {
    color: #17231c;
}

html[data-theme="light"] .analytics-stat-content strong i {
    color: #718078;
}

html[data-theme="light"] .analytics-stat-content small {
    color: #78857e;
}

html[data-theme="light"] .analytics-panel {
    background:
        radial-gradient(
            circle at 100% 0%,
            rgba(95,159,39,.045),
            transparent 32%
        ),
        #ffffff;

    border-color: rgba(18,32,24,.09);

    box-shadow:
        0 15px 42px rgba(20,35,27,.055);
}

html[data-theme="light"] .panel-title-group > div:last-child > span {
    color: #748179;
}

html[data-theme="light"] .panel-icon {
    background: rgba(95,159,39,.07);
    border-color: rgba(95,159,39,.14);
    color: #609a2d;
}

html[data-theme="light"] .analytics-empty {
    background: #ffffff;
    border-color: rgba(95,159,39,.20);
}

html[data-theme="light"] .analytics-empty-content p {
    color: #68766e;
}


/* =========================================================
   RESPONSIVE
   ========================================================= */

@media (max-width: 1000px) {

    .analytics-kpis {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

}

@media (max-width: 760px) {

    .analytics-head {
        align-items: flex-start;
    }

    .analytics-scope {
        margin-top: 4px;
    }

    .analytics-grid {
        grid-template-columns: 1fr;
    }

    .analytics-grid .analytics-yield-panel,
    .analytics-grid .analytics-environment-panel {
        grid-column: auto;
    }

    .analytics-chart {
        height: 260px;
    }

    .analytics-crop-panel .analytics-chart {
        height: 270px;
    }

    .analytics-empty {
        align-items: flex-start;
    }

}

@media (max-width: 560px) {

    .analytics-kpis {
        grid-template-columns: 1fr;
    }

    .analytics-stat-card {
        padding: 16px;
    }

    .analytics-stat-icon {
        width: 39px;
        height: 39px;
        flex-basis: 39px;
    }

    .analytics-stat-content strong {
        font-size: 24px;
    }

    .analytics-panel {
        padding: 17px;
    }

    .analytics-panel-head {
        align-items: flex-start;
    }

    .panel-title-group {
        gap: 9px;
    }

    .panel-title-group h2 {
        font-size: 14px;
    }

    .panel-title-group > div:last-child > span {
        white-space: normal;
        line-height: 1.4;
    }

    .analytics-chart {
        height: 235px;
    }

    .analytics-crop-panel .analytics-chart {
        height: 245px;
    }

    .analytics-empty {
        flex-direction: column;
        padding: 22px;
    }

}